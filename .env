# PostgreSQL Database Environment Variables
# Used by docker-compose.yml

POSTGRES_DB=meal_recommendation
POSTGRES_USER=meal_user
POSTGRES_PASSWORD=meal_password
POSTGRES_ROOT_PASSWORD=root_password

# Container settings
POSTGRES_INITDB_ARGS=-c shared_buffers=256MB -c max_connections=100

# Timezone
TZ=Asia/Shanghai

AI_ARK_BASE_URL=https://openrouter.ai/api/v1
AI_ARK_PROTOCOL=chat
AI_ARK_MODEL=openai/gpt-4.1-mini
AI_ARK_API_KEY=sk-or-v1-8d8dd51539ae6ce8fde1f5c639bce93a8d281c3664600d3ee95ae6a>
